# Скопировать в .env и заполнить своими значениями:  cp .env.example .env

# --- Gemini (llm_processor.py) ---
GEMINI_API_KEY=your-api-key-here
# Набор моделей зависит от аккаунта — узнать свой: python llm_processor.py --list-models
GEMINI_MODEL=gemini-3.6-flash
# Запасная на случай перегрузки основной (503). Оставьте пустым, если не уверены,
# что модель вам доступна: её 404 только запутает диагностику.
GEMINI_FALLBACK_MODEL=

# --- Источник задач (scraper.py) ---
KOMPEGE_API_URL=https://kompege.ru/api/v1
KOMPEGE_TASK_URL=https://kompege.ru/task
# база для относительных ссылок на файлы задач (.txt, .ods, .odt)
KOMPEGE_FILES_URL=https://kompege.ru/

# --- Админка (auth_state.py, uploader.py) ---
ADMIN_LOGIN_URL=https://example.com/admin/login
ADMIN_CREATE_TASK_URL=https://example.com/admin/tasks/create
AUTH_STATE_PATH=auth_state.json
